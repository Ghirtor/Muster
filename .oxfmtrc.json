{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/web/index.css"
  },
  "ignorePatterns": [
    "*",
    "!*.js",
    "!*.ts",
    "!*.cjs",
    "!*.mjs",
    "!*.jsx",
    "!*.tsx",
    "!*/",
    "node_modules/",
    "out/",
    "build/",
    ".npm/",
    "public/",
    "design/",
    "reference/",
    "coverage/",
    "dist/",
    "src-tauri/target/",
    "src-tauri/gen/"
  ]
}
