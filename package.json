{
  "name": "flotilla",
  "version": "0.1.0",
  "description": "Launch, watch and hand over local app rigs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node gitHooks/setup.mjs",
    "dev": "node scripts/check-deps.mjs && npm run start",
    "dev:desktop": "node scripts/check-deps.mjs && cross-env WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=4872 tauri dev",
    "start": "concurrently -n server,web -c magenta,blue --kill-others-on-fail \"tsx watch --tsconfig src/server/tsconfig.json src/server/main.ts\" \"vite --config vite.web.config.ts\"",
    "build": "vite build --config vite.web.config.ts && vite build --config vite.server.config.ts",
    "lint": "oxlint --report-unused-disable-directives-severity=warn",
    "type-check": "concurrently -n web,server,tooling -c blue,magenta,gray --kill-others-on-fail \"node node_modules/typescript7/bin/tsc -p src/web\" \"node node_modules/typescript7/bin/tsc -p src/server\" \"node node_modules/typescript7/bin/tsc -p .\"",
    "format": "oxfmt --threads=1",
    "format:check": "oxfmt --threads=1 --check",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "package": "tauri build --no-bundle",
    "bundle": "tauri build",
    "flotilla": "tsx --tsconfig src/server/tsconfig.json src/server/cli.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-ws": "^12.2.0",
    "@nestjs/websockets": "^12.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "~2.11.0",
    "axios": "^1.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.7.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@tauri-apps/cli": "~2.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "react-devtools": "^7.0.0",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^7.1.5"
  }
}
