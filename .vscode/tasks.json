{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "desktop",
      "type": "npm",
      "script": "dev:desktop",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tauri",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "Running BeforeDevCommand",
          "endsPattern": "Running `"
        }
      }
    },
    {
      "label": "stop desktop",
      "command": "${input:terminateDesktop}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateDesktop",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "desktop"
    }
  ]
}
