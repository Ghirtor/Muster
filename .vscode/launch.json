{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Supervisor",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server/main.ts",
      "runtimeArgs": [
        "--import",
        "tsx"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    },
    {
      "name": "Dashboard",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4870",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "dashboard",
      "postDebugTask": "stop dashboard"
    },
    {
      "name": "Desktop (Tauri, WebView2)",
      "type": "msedge",
      "request": "attach",
      "port": 4872,
      "webRoot": "${workspaceFolder}",
      "urlFilter": "http://localhost:4870/*",
      "preLaunchTask": "desktop",
      "postDebugTask": "stop desktop"
    },
    {
      "name": "Jest: current file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--watchAll=false",
        "${relativeFile}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Flotilla (supervisor + dashboard)",
      "configurations": [
        "Supervisor",
        "Dashboard"
      ],
      "stopAll": true
    }
  ]
}
