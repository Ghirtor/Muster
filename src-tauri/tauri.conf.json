{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flotilla",
  "version": "0.1.0",
  "identifier": "com.ghirtor.flotilla",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:4870",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/server/": "server/",
      "../dist/web/": "web/",
      "cli/flotilla": "bin/flotilla"
    }
  }
}
