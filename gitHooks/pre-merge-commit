#!/bin/sh

PREFIX="merge:"

# Feature branches keep a near-linear history: they take main's new commits by
# rebasing onto it, and reach main themselves as one merge commit, so the history
# of main stays semi-linear. The one merge a feature branch may make is
# a first-time merge of another feature branch. Refused here:
#
# - merging main in (to take its new commits or settle conflicts), and
# - re-syncing with a branch it already shares work with beyond main: merging the
#   same feature branch again after it moved, or the branch it was started from.
#
# Both are told apart from a first-time merge the way CI's linear-history job
# does it, which refuses the pull request anyway: the merged commit is already
# in main, or the branches' merge base is not. main takes any merge: that
# is how a feature lands.
#
# Both tests need the merged heads in MERGE_HEAD, which git writes only after
# running this as its pre-merge-commit hook, so that call finds none and passes.
# commit-msg calls this again once MERGE_HEAD is there, for a merge that went
# through on its own and for one concluded by `git commit` after conflicts.

branchName=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

case "${branchName}" in
  ""|main)
    exit 0
    ;;
esac

# The local branch counts too: a main ahead of origin/main is still main.
bases=""
for ref in origin/main main; do
  if git rev-parse --quiet --verify "${ref}^{commit}" > /dev/null; then
    bases="${bases} ${ref}"
  fi
done

# No main to measure against (a clone that never fetched it): CI still checks.
[ -n "${bases}" ] || exit 0

inBase () {
  for base in ${bases}; do
    git merge-base --is-ancestor "$1" "${base}" && return 0
  done
  return 1
}

gitDir=$(git rev-parse --git-dir)
for parent in $(cat "${gitDir}/MERGE_HEAD" 2>/dev/null); do
  if inBase "${parent}"; then
    echo "${PREFIX} This merges main into ${branchName}, which takes no such merge." >&2
  elif ! inBase "$(git merge-base HEAD "${parent}")"; then
    echo "${PREFIX} ${branchName} already shares work with the branch it merges (merged it before, or started from it)." >&2
  else
    continue
  fi
  echo "${PREFIX} Drop this merge and rebase instead:" >&2
  echo "${PREFIX}   git merge --abort && git fetch origin && git rebase origin/main   (or onto that branch)" >&2
  exit 1
done

exit 0
